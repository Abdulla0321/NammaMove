# Copy to ignored .env. No secret is required for the Phase 00 simulator.
APP_ENV=development
# Simulation defaults off in production; these endpoints never access live routing.
SIMULATION_ENABLED=true
# Local Docker admin/migration identity ONLY. Choose a private local password.
POSTGRES_DB=nammamove
POSTGRES_USER=nammamove
POSTGRES_PASSWORD=replace-with-local-only-password
# Set locally after starting PostgreSQL; URL-encode special password characters.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nammamove
# Runtime DATABASE_URL must use a separate non-owner login (docs/DATABASE.md).
# Supabase project origin (public configuration, not a service-role key).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Opt-in integration tests ONLY: empty disposable database name must end _test.
# NAMMAMOVE_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nammamove_test

# Phase 03: optional sealed synthetic OTP graph; never live Bengaluru coverage.
# OTP_URL=http://127.0.0.1:18081
# OTP_MANIFEST=C:/absolute/path/to/dedicated-build/manifest.json
# NAMMAMOVE_TEST_OTP_URL=http://127.0.0.1:18081
# NAMMAMOVE_TEST_OTP_DIR=C:/absolute/path/to/dedicated-build
