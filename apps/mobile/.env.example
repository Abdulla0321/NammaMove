EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Only a public publishable/legacy anon key, never a secret/service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Expo Go needs no project Maps key. Custom Android builds require a Maps SDK
# key restricted to the package/signing SHA-1; changing it requires a native rebuild.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# EAS development profile sets NAMMAMOVE_REQUIRE_ANDROID_MAPS=true to reject
# missing-key native configuration. Keep keys out of eas.json and source files.
