{
  "name": "@nammamove/mobile",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "build": "expo export --platform web",
    "build:android": "expo export --platform android --output-dir dist-android",
    "contracts": "node scripts/contracts.mjs",
    "integration": "node --import tsx scripts/integration.mts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-community/datetimepicker": "8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~55.0.32",
    "expo-location": "~55.1.15",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.22",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
